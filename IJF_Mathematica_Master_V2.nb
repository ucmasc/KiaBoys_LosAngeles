Cell[CellGroupData[{
Cell["\<\
Mathematica Code for \[OpenCurlyDoubleQuote]Forecasting the impact of the \
viral \[OpenCurlyQuote]Kia Boys\[CloseCurlyQuote] social media trend on car \
thefts to 2050\[CloseCurlyDoubleQuote]
\
\>", "Title",
 CellChangeTimes->{{3.986406329134389*^9, 3.9864063715176687`*^9}, {
   3.986408104203012*^9, 3.986408107581398*^9}, 
   3.988049662411152*^9},ExpressionUUID->"2bc2ba5a-4220-4963-a515-\
ff7b2cde1d6f"],

Cell[TextData[{
 StyleBox["The following code reproduces:",
  FontWeight->"Bold"],
 "\n\nFigure 1, Figure 2, Figure 3A (excluding map), Figure 4, Figure 5, \
Figure 6 (excluding map), Figure 7, Figure 8, and Figure 9.\n\n",
 StyleBox["Code Sections:",
  FontWeight->"Bold"],
 "\n\nData: A code block that loads all of the needed data at once.\nMain \
Text Figures: Code reproducing each figure.\nSupplemental Movies: Code to \
reproduce the supplemental movies.\n\n",
 StyleBox["Notes:",
  FontWeight->"Bold"],
 " \t\n\nMaps panels (Figure 3B) and Figure 6A were generated in Qgis and \
cannot be reproduced here.\n\nFigure 10 is reproduced in associated R code.\n\
\t\nFigure layout, including arrows and labeling, was completed in \
PowerPoint. These features are not reproduced in the code below.\n\nThere is \
some redundancy in variable naming."
}], "Subtitle",
 CellChangeTimes->{{3.986406381386763*^9, 3.9864064329188643`*^9}, {
  3.98640809515508*^9, 3.9864081724526663`*^9}, {3.987620120619912*^9, 
