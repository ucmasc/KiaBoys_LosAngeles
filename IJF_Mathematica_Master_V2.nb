Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stringToNumberWithSuffix", "[", "s_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"numString", ",", "suffix", ",", "number"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"numString", ",", "suffix"}], "}"}], "=", 
       RowBox[{
        RowBox[{"StringCases", "[", 
         RowBox[{"s", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", ":", "NumberString"}], ")"}], "~~", 
            RowBox[{"(", 
             RowBox[{"c", ":", 
              
              RowBox[{"\"\<K\>\"", "|", "\"\<M\>\"", "|", "\"\<B\>\"", 
               "|", "\"\<T\>\"", "|", "\"\<\>\""}]}], ")"}]}], ":>", 
           RowBox[{"{", 
            RowBox[{"n", ",", "c"}], "}"}]}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"number", "=", 
       RowBox[{"ToExpression", "[", "numString", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Switch", "[", 
       RowBox[{"suffix", ",", "\"\<K\>\"", ",", 
        RowBox[{"number", "*", "1000"}], ",", "\"\<M\>\"", ",", 
        RowBox[{"number", "*", "1000000"}], ",", "\"\<B\>\"", ",", 
        RowBox[{"number", "*", "1000000000"}], ",", "\"\<T\>\"", ",", 
        RowBox[{"number", "*", "1000000000000"}], ",", "\"\<\>\"", ",", 
        "number", ",", "_", ",", "number"}], " ", 
       RowBox[{"(*", 
        RowBox[{
        "default", " ", "if", " ", "no", " ", "recognized", " ", "suffix"}], 
        "*)"}], "]"}]}]}], "]"}]}], "\n"}]], "Input",
